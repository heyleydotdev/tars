{
  "name": "@tars/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "git clean -xdf .wrangler .cache",
    "dev": "wrangler dev --env-file ../../.env",
    "start": "wrangler dev --env-file ../../.env",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "typegen": "wrangler types",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "lint": "eslint .",
    "typecheck": "bun check -b --no-script",
    "format": "bun fmt --check --no-script . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "format:write": "bun fmt --no-script . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "@tars/eslint": "workspace:*",
    "@tars/prettier": "workspace:*",
    "@tars/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "wrangler": "4.153.0",
    "@cloudflare/vitest-plugin": "1.4.11",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@tars/prettier",
  "dependencies": {
    "@tars/api": "workspace:*",
    "@tars/auth": "workspace:*",
    "@tars/core": "workspace:*",
    "@tars/db": "workspace:*",
    "hono": "4.13.14"
  }
}
