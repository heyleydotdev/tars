{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Main Process (desktop)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/desktop",
      "runtimeExecutable": "${workspaceFolder}/apps/desktop/node_modules/.bin/electron-vite",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/apps/desktop/node_modules/.bin/electron-vite.exe"
      },
      "runtimeArgs": ["--sourcemap"],
      "env": {
        "REMOTE_DEBUGGING_PORT": "9222"
      }
    },
    {
      "name": "Debug Renderer Process (desktop)",
      "port": 9222,
      "request": "attach",
      "type": "chrome",
      "webRoot": "${workspaceFolder}/apps/desktop/src/renderer",
      "timeout": 60000,
      "presentation": {
        "hidden": true
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug All (desktop)",
      "configurations": ["Debug Main Process (desktop)", "Debug Renderer Process (desktop)"],
      "presentation": {
        "order": 1
      }
    }
  ]
}
