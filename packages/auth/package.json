{
  "name": "@tars/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./electron": "./src/electron.ts",
    "./preload": "./src/preload.ts",
    "./server": "./src/server.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "auth generate -y --config auth.config.ts --output ../db/src/auth-schema.ts",
    "typecheck": "bun check --no-script",
    "lint": "eslint .",
    "format": "bun fmt --check --no-script . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "format:write": "bun fmt --no-script . --ignore-path ../../.gitignore --ignore-path .prettierignore"
  },
  "dependencies": {
    "@better-auth/electron": "1.7.14",
    "@tars/db": "workspace:*",
    "better-auth": "1.7.14",
    "conf": "^15.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "auth": "1.7.14",
    "@tars/eslint": "workspace:*",
    "@tars/prettier": "workspace:*",
    "@tars/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@tars/prettier"
}
