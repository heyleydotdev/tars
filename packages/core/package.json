{
  "name": "@tars/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./constants": "./src/constants.ts",
    "./errors": "./src/errors.ts",
    "./schemas/*": "./src/schemas/*.ts",
    "./utils/*": "./src/utils/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "bun check --no-script",
    "lint": "eslint .",
    "format": "bun fmt --check --no-script . --ignore-path ../../.gitignore",
    "format:write": "bun fmt --no-script . --ignore-path ../../.gitignore"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tars/eslint": "workspace:*",
    "@tars/prettier": "workspace:*",
    "@tars/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@tars/prettier"
}
