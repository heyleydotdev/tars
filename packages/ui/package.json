{
  "name": "@tars/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "bun check --no-script",
    "lint": "eslint .",
    "format": "bun fmt --check --no-script . --ignore-path ../../.gitignore",
    "format:write": "bun fmt --no-script . --ignore-path ../../.gitignore",
    "ui:add": "shadcn add"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "catalog:",
    "shadcn": "4.22.1",
    "streamdown": "2.7.1",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tars/eslint": "workspace:*",
    "@tars/prettier": "workspace:*",
    "@tars/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "prettier": "@tars/prettier"
}
