{
  "name": "tars",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*"
    ],
    "catalog": {
      "@orpc/client": "^2.0.0-beta.44",
      "@orpc/server": "^2.0.0-beta.44",
      "@cloudflare/workers-types": "5.20260921.1",
      "drizzle-orm": "^0.45.4",
      "@tailwindcss/vite": "4.3.3",
      "@types/node": "24.19.2",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "6.1.2",
      "eslint": "10.10.0",
      "lucide-react": "1.61.0",
      "prettier": "3.9.9",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "tailwindcss": "4.3.3",
      "typescript": "5.9.3",
      "vite": "8.3.5",
      "wrangler": "4.148.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "turbo run format format:root",
    "format:write": "turbo run format:write format:write:root",
    "format:root": "bun fmt --check --no-script \"*.md\" \"*.json\" \".vscode/*.json\"",
    "format:write:root": "bun fmt --no-script \"*.md\" \"*.json\" \".vscode/*.json\"",
    "generate": "bun run --filter=@tars/auth generate && bun run --filter=@tars/db generate",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.0.0",
    "@tars/prettier": "workspace:*",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4"
    }
  },
  "prettier": "@tars/prettier"
}
