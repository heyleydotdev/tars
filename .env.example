# Server (apps/server) reads these through `wrangler dev --env-file ../../.env`.
# Generate the secret with `bunx auth@latest secret`; deployed values go through
# `wrangler secret put` (declared in wrangler.jsonc `secrets.required`).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Desktop main process, inlined into the build by electron-vite. Set this to the
# deployed worker URL before `bun run build:win|mac|linux` for packaged builds.
VITE_BETTER_AUTH_URL=http://localhost:3001
